{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sharodsamagam",
  "workers_dev": true,
  "compatibility_date": "2026-01-15",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false
  },
  "routes": [
    {
      "pattern": "sharodsamagam.dpdns.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}