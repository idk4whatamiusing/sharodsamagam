# Copy to .env and fill in. Never commit the filled-in version.
#
# Create the token at: Cloudflare dashboard -> My Profile -> API Tokens
# Use the "Edit Cloudflare Workers" template, restricted to the account
# below, with Workers Scripts:Edit. No zone or R2 permissions needed.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=a3e11fe1b443619336af948c81b66375

# For local `npx wrangler deploy` you do not need the token at all if you
# have run `npx wrangler login` — wrangler uses its own OAuth session.
# Wrangler reads .env automatically when CLOUDFLARE_API_TOKEN is present.